{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Central Asia B2G Knowledge Graph",
  "description": "Canonical data model. Every agent reads/writes records conforming to these schemas.",
  "type": "object",
  "definitions": {
    "VerificationTag": {
      "type": "string",
      "enum": ["VERIFIED", "L2_VERIFIED", "L3_VERIFIED", "INFERRED", "UNVERIFIED", "CONTRADICTED"]
    },
    "Country": {
      "type": "string",
      "enum": ["UZ", "KG", "BOTH"]
    },
    "Source": {
      "type": "object",
      "required": ["url", "title", "language", "fetched_at"],
      "properties": {
        "url": {"type": "string", "format": "uri"},
        "title": {"type": "string"},
        "language": {"type": "string", "enum": ["ru", "uz", "ky", "en", "uz-cyrl", "uz-latn"]},
        "fetched_at": {"type": "string", "format": "date"},
        "publisher": {"type": "string"},
        "source_tier": {"type": "string", "enum": ["official", "media_primary", "media_secondary", "expert_commentary", "international_org", "social"]}
      }
    },
    "Decree": {
      "type": "object",
      "required": ["id", "country", "decree_type", "number", "date", "title_original", "title_en", "verification", "sources"],
      "properties": {
        "id": {"type": "string", "description": "slug like UZ-PP-2024-403"},
        "country": {"$ref": "#/definitions/Country"},
        "decree_type": {"type": "string", "enum": ["UP", "PP", "Resolution", "Law", "MinisterialOrder", "PresidentialDecree", "CabinetResolution"]},
        "number": {"type": "string"},
        "date": {"type": "string", "format": "date"},
        "signatory": {"type": "string"},
        "title_original": {"type": "string"},
        "title_en": {"type": "string"},
        "subject_areas": {"type": "array", "items": {"type": "string"}},
        "ai_digital_provisions": {"type": "string"},
        "implementation_deadline": {"type": "string", "format": "date"},
        "responsible_agency_ids": {"type": "array", "items": {"type": "string"}},
        "responsible_person_ids": {"type": "array", "items": {"type": "string"}},
        "budget_allocated_usd": {"type": ["number", "null"]},
        "budget_disclosed": {"type": "boolean"},
        "co_financing_donor_ids": {"type": "array", "items": {"type": "string"}},
        "half_life_status": {"type": "string", "enum": ["active_window", "implementing", "expired", "amended", "repealed"]},
        "status_as_of": {"type": "string", "format": "date"},
        "verification": {"$ref": "#/definitions/VerificationTag"},
        "sources": {"type": "array", "items": {"$ref": "#/definitions/Source"}, "minItems": 1}
      }
    },
    "Institution": {
      "type": "object",
      "required": ["id", "country", "tier", "name_en", "name_ru", "verification", "sources", "last_verified_date"],
      "properties": {
        "id": {"type": "string", "description": "slug like UZ-MOJ or KG-MINCIFRI"},
        "country": {"$ref": "#/definitions/Country"},
        "tier": {"type": "integer", "minimum": 1, "maximum": 8, "description": "1=Pres Admin, 2=Cabinet, 3=Ministry, 4=Agency, 5=SOE, 6=Regulator, 7=WorkingGroup, 8=DonorPIU"},
        "name_en": {"type": "string"},
        "name_ru": {"type": "string"},
        "name_local": {"type": "string", "description": "Uzbek or Kyrgyz"},
        "founding_decree_id": {"type": "string"},
        "reports_to_id": {"type": "string"},
        "head_person_id": {"type": "string"},
        "deputy_person_ids": {"type": "array", "items": {"type": "string"}},
        "annual_budget_usd": {"type": ["number", "null"]},
        "staff_size": {"type": ["integer", "null"]},
        "headquarters_address": {"type": "string"},
        "official_website": {"type": "string"},
        "ai_digital_mandate": {"type": "string"},
        "recent_decisions_12mo": {"type": "array", "items": {"type": "string"}},
        "status": {"type": "string", "enum": ["active", "restructured", "dissolved", "merged"]},
        "last_verified_date": {"type": "string", "format": "date"},
        "verification": {"$ref": "#/definitions/VerificationTag"},
        "sources": {"type": "array", "items": {"$ref": "#/definitions/Source"}, "minItems": 1}
      }
    },
    "Person": {
      "type": "object",
      "required": ["id", "full_name_latin", "country", "current_role", "current_institution_id", "verification", "last_verified_date"],
      "properties": {
        "id": {"type": "string", "description": "slug like uz-saidov-sherzod"},
        "full_name_latin": {"type": "string"},
        "full_name_ru": {"type": "string"},
        "full_name_local": {"type": "string"},
        "country": {"$ref": "#/definitions/Country"},
        "current_role": {"type": "string"},
        "current_institution_id": {"type": "string"},
        "tenure_start": {"type": "string", "format": "date"},
        "linkedin_url": {"type": ["string", "null"]},
        "linkedin_status": {"type": "string", "enum": ["verified", "not_found", "private", "unverified_match"]},
        "twitter_handle": {"type": ["string", "null"]},
        "telegram_handle": {"type": ["string", "null"]},
        "facebook_url": {"type": ["string", "null"]},
        "email_pattern_guess": {"type": ["string", "null"]},
        "office_phone": {"type": ["string", "null"]},
        "education": {"type": "array", "items": {"type": "object", "properties": {"institution": {"type": "string"}, "degree": {"type": "string"}, "year": {"type": "integer"}}}},
        "career_history": {"type": "array", "items": {"type": "object", "properties": {"role": {"type": "string"}, "institution": {"type": "string"}, "from": {"type": "string"}, "to": {"type": "string"}}}},
        "languages": {"type": "array", "items": {"type": "string"}},
        "international_exposure": {"type": "array", "items": {"type": "string"}},
        "decree_authorship_ids": {"type": "array", "items": {"type": "string"}},
        "public_statements_ai_digital": {"type": "array", "items": {"type": "object", "properties": {"date": {"type": "string"}, "venue": {"type": "string"}, "summary": {"type": "string"}, "url": {"type": "string"}}}},
        "patron_id": {"type": ["string", "null"], "description": "Person who promoted them"},
        "donor_counterparts": {"type": "array", "items": {"type": "string"}},
        "vendor_relationships": {"type": "array", "items": {"type": "string"}},
        "diaspora_advisor_flag": {"type": "boolean", "default": false},
        "diaspora_location": {"type": ["string", "null"]},
        "priority_tier": {"type": "integer", "enum": [1, 2, 3]},
        "pitch_hook": {"type": "string", "maxLength": 300},
        "access_paths": {"type": "array", "items": {"type": "object", "properties": {"path_type": {"type": "string", "enum": ["warm_intro", "cold_outreach", "conference", "donor_pathway"]}, "details": {"type": "string"}}}},
        "last_verified_date": {"type": "string", "format": "date"},
        "verification": {"$ref": "#/definitions/VerificationTag"},
        "sources": {"type": "array", "items": {"$ref": "#/definitions/Source"}}
      }
    },
    "DonorProgram": {
      "type": "object",
      "required": ["id", "donor", "program_name", "country", "status", "verification", "sources"],
      "properties": {
        "id": {"type": "string"},
        "donor": {"type": "string", "enum": ["WorldBank", "ADB", "EBRD", "EU", "EU_GIZ", "EU_AFD", "USAID_successor", "JICA", "KOICA", "UNDP", "UNICEF", "ITU", "WFP", "IFC", "IsDB", "AIIB", "EDB", "EFSD", "Sida", "FCDO", "SDC", "BMGF", "OSF", "AKDN", "TIKA", "China_DSR", "Other"]},
        "program_name": {"type": "string"},
        "program_id_external": {"type": "string", "description": "P-number for World Bank, ADB project ID, etc."},
        "country": {"$ref": "#/definitions/Country"},
        "implementing_ministry_id": {"type": "string"},
        "piu_institution_id": {"type": "string"},
        "total_budget_usd": {"type": ["number", "null"]},
        "disbursed_usd": {"type": ["number", "null"]},
        "period_start": {"type": "string", "format": "date"},
        "period_end": {"type": "string", "format": "date"},
        "procurement_modality": {"type": "string", "enum": ["ICB", "NCB", "QCBS", "CQS", "shopping", "direct", "RFP", "mixed"]},
        "ai_digital_relevance": {"type": "string"},
        "ttl_pm_name": {"type": "string"},
        "ttl_pm_email": {"type": ["string", "null"]},
        "government_counterpart_person_id": {"type": "string"},
        "pipeline_tenders": {"type": "array", "items": {"type": "object", "properties": {"title": {"type": "string"}, "expected_date": {"type": "string"}, "estimated_value_usd": {"type": "number"}}}},
        "vendor_entry_pathway": {"type": "string"},
        "status": {"type": "string", "enum": ["pipeline", "appraisal", "active", "closing", "closed", "suspended"]},
        "verification": {"$ref": "#/definitions/VerificationTag"},
        "sources": {"type": "array", "items": {"$ref": "#/definitions/Source"}, "minItems": 1}
      }
    },
    "Tender": {
      "type": "object",
      "required": ["id", "country", "title", "issuing_entity_id", "status", "verification"],
      "properties": {
        "id": {"type": "string"},
        "country": {"$ref": "#/definitions/Country"},
        "title": {"type": "string"},
        "title_en": {"type": "string"},
        "issuing_entity_id": {"type": "string"},
        "reference_number": {"type": "string"},
        "issue_date": {"type": "string", "format": "date"},
        "submission_deadline": {"type": "string", "format": "date"},
        "estimated_value_usd": {"type": ["number", "null"]},
        "currency_original": {"type": "string"},
        "value_original": {"type": ["number", "null"]},
        "procurement_method": {"type": "string"},
        "eligibility": {"type": "string", "enum": ["foreign_eligible", "local_only", "joint_venture_required", "donor_rules"]},
        "linked_decree_id": {"type": "string"},
        "linked_donor_program_id": {"type": "string"},
        "ai_digital_scope": {"type": "string"},
        "category": {"type": "string", "enum": ["AI_ML", "GovTech_Platform", "Data_Cloud", "Skills_Training", "Cybersecurity", "Sectoral_Vertical", "Advisory", "Hardware_Adjacent"]},
        "incumbent_risk": {"type": "string", "enum": ["high", "medium", "low", "none"]},
        "win_probability": {"type": "string", "enum": ["high", "medium", "low"]},
        "win_probability_rationale": {"type": "string"},
        "status": {"type": "string", "enum": ["live", "forthcoming", "closed", "cancelled"]},
        "tender_url": {"type": "string"},
        "verification": {"$ref": "#/definitions/VerificationTag"},
        "sources": {"type": "array", "items": {"$ref": "#/definitions/Source"}}
      }
    },
    "Trend": {
      "type": "object",
      "required": ["id", "name", "country", "sector", "maturity", "verification"],
      "properties": {
        "id": {"type": "string"},
        "name": {"type": "string"},
        "country": {"$ref": "#/definitions/Country"},
        "sector": {"type": "string"},
        "maturity": {"type": "string", "enum": ["emerging", "accelerating", "mainstream", "declining"]},
        "drivers": {"type": "array", "items": {"type": "string"}},
        "estimated_tam_2025_2026_usd": {"type": ["number", "null"]},
        "key_decision_maker_ids": {"type": "array", "items": {"type": "string"}},
        "linked_decree_ids": {"type": "array", "items": {"type": "string"}},
        "linked_donor_program_ids": {"type": "array", "items": {"type": "string"}},
        "linked_tender_ids": {"type": "array", "items": {"type": "string"}},
        "window_months_remaining": {"type": "integer"},
        "win_conditions": {"type": "string"},
        "killer_app_description": {"type": "string"},
        "lens_tags": {"type": "array", "items": {"type": "string", "enum": ["karimov_inversion", "japarov_concentration", "decree_half_life_active", "donor_co_financed", "diaspora_bridge", "russian_cis_substitution"]}},
        "verification": {"$ref": "#/definitions/VerificationTag"},
        "sources": {"type": "array", "items": {"$ref": "#/definitions/Source"}}
      }
    },
    "GlobalCase": {
      "type": "object",
      "required": ["id", "case_name", "country_origin", "sector", "verification"],
      "properties": {
        "id": {"type": "string"},
        "case_name": {"type": "string"},
        "country_origin": {"type": "string"},
        "sector": {"type": "string"},
        "year_initiated": {"type": "integer"},
        "year_matured": {"type": "integer"},
        "problem_solved": {"type": "string"},
        "architecture_summary": {"type": "string"},
        "implementation_budget_usd": {"type": ["number", "null"]},
        "vendors_involved": {"type": "array", "items": {"type": "string"}},
        "donor_co_financed": {"type": "boolean"},
        "outcome_metrics": {"type": "string"},
        "failure_modes": {"type": "string"},
        "replicability_factors": {"type": "string"},
        "uz_transferability_score": {"type": "integer", "minimum": 1, "maximum": 10},
        "uz_transferability_rationale": {"type": "string"},
        "uz_analogue_institution_id": {"type": "string"},
        "kg_transferability_score": {"type": "integer", "minimum": 1, "maximum": 10},
        "kg_transferability_rationale": {"type": "string"},
        "kg_analogue_institution_id": {"type": "string"},
        "key_adaptation_required": {"type": "string"},
        "verification": {"$ref": "#/definitions/VerificationTag"},
        "sources": {"type": "array", "items": {"$ref": "#/definitions/Source"}}
      }
    },
    "SolopreneurMVP": {
      "type": "object",
      "description": "A solopreneur-bootstrappable MVP idea grounded in the knowledge graph + HubSpot $1M Solopreneur MVR framework.",
      "required": ["id", "country", "short_name", "tagline", "category", "underlying_demand", "target_customer", "monetization", "mvr_plan", "validation", "scoring", "verification"],
      "properties": {
        "id": {"type": "string", "description": "slug like uz-mvp-001"},
        "country": {"$ref": "#/definitions/Country"},
        "short_name": {"type": "string", "maxLength": 60},
        "tagline": {"type": "string", "maxLength": 200},
        "category": {"type": "string", "enum": ["managed_service", "saas", "content", "free_tool", "marketplace", "ai_tool", "demo_video", "ad_validated"]},
        "sector": {"type": "string"},
        "underlying_demand": {
          "type": "object",
          "required": ["pain_point", "evidence"],
          "properties": {
            "trend_id": {"type": ["string", "null"]},
            "decree_id": {"type": ["string", "null"]},
            "donor_program_id": {"type": ["string", "null"]},
            "pain_point": {"type": "string", "maxLength": 1000},
            "evidence": {"type": "string", "description": "URL or short citation"}
          }
        },
        "target_customer": {"type": "string", "maxLength": 400},
        "monetization": {
          "type": "object",
          "required": ["model", "price_point_usd", "year_1_revenue_target_usd"],
          "properties": {
            "model": {"type": "string", "enum": ["subscription", "one_time", "services", "listing_fee", "ad", "freemium", "donation"]},
            "price_point_usd": {"type": "number", "minimum": 0},
            "year_1_revenue_target_usd": {"type": "number", "minimum": 0},
            "year_3_revenue_target_usd": {"type": "number", "minimum": 0}
          }
        },
        "mvr_plan": {
          "type": "object",
          "required": ["vehicle", "build_steps", "build_time_days", "build_cost_usd"],
          "properties": {
            "vehicle": {"type": "string", "enum": ["landing_page", "squeeze_page", "demo_video", "free_tool", "directory", "wizard_of_oz", "ad_booking", "manifesto"]},
            "build_steps": {"type": "array", "items": {"type": "string"}, "minItems": 3, "maxItems": 12},
            "build_time_days": {"type": "integer", "minimum": 1, "maximum": 14},
            "build_cost_usd": {"type": "number", "minimum": 0, "maximum": 1000}
          }
        },
        "validation": {
          "type": "object",
          "required": ["signal_target", "validation_window_days", "channels"],
          "properties": {
            "signal_target": {"type": "string", "description": "quantified, e.g. 100 waitlist signups in 30 days"},
            "validation_window_days": {"type": "integer", "minimum": 7, "maximum": 90},
            "channels": {"type": "array", "items": {"type": "string"}, "minItems": 1}
          }
        },
        "tech_stack": {"type": "array", "items": {"type": "string"}},
        "founder_capability_required": {"type": "array", "items": {"type": "string"}},
        "moat_potential": {"type": "string"},
        "risk_register": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "risk": {"type": "string"},
              "mitigation": {"type": "string"}
            }
          }
        },
        "scoring": {
          "type": "object",
          "required": ["demand_clarity", "speed_to_mvr", "monetization_path", "founder_solo_feasibility", "local_market_fit", "weighted_total"],
          "properties": {
            "demand_clarity": {"type": "integer", "minimum": 1, "maximum": 10},
            "speed_to_mvr": {"type": "integer", "minimum": 1, "maximum": 10},
            "monetization_path": {"type": "integer", "minimum": 1, "maximum": 10},
            "founder_solo_feasibility": {"type": "integer", "minimum": 1, "maximum": 10},
            "local_market_fit": {"type": "integer", "minimum": 1, "maximum": 10},
            "weighted_total": {"type": "number"},
            "scoring_rationale": {"type": "string"}
          }
        },
        "confidence_tier": {"type": "string", "enum": ["A", "B", "C", "D"]},
        "linked_initiative_id": {"type": ["string", "null"]},
        "verification": {"$ref": "#/definitions/VerificationTag"}
      }
    },
    "Initiative": {
      "type": "object",
      "required": ["id", "short_name", "country", "sector", "one_liner", "problem_statement", "solution_concept", "target_buyer_person_id", "scoring", "verification"],
      "properties": {
        "id": {"type": "string"},
        "short_name": {"type": "string"},
        "country": {"$ref": "#/definitions/Country"},
        "sector": {"type": "string"},
        "one_liner": {"type": "string", "maxLength": 200},
        "problem_statement": {"type": "string", "maxLength": 800},
        "solution_concept": {"type": "string", "maxLength": 1500},
        "precedent_case_id": {"type": "string"},
        "what_preserved": {"type": "string"},
        "what_adapted": {"type": "string"},
        "authorizing_decree_ids": {"type": "array", "items": {"type": "string"}},
        "regulatory_hurdles": {"type": "string"},
        "ppp_feasible": {"type": "boolean"},
        "lead_institution_id": {"type": "string"},
        "target_buyer_person_id": {"type": "string"},
        "operational_counterpart_person_id": {"type": "string"},
        "procurement_pathway": {"type": "string", "enum": ["direct", "tender", "donor_program", "ppp", "revenue_share", "pilot_then_scale"]},
        "primary_funding": {"type": "string"},
        "secondary_funding_donor_program_id": {"type": "string"},
        "estimated_initial_contract_usd": {"type": "number"},
        "estimated_3yr_revenue_usd": {"type": "number"},
        "competitive_landscape": {"type": "string"},
        "incumbents": {"type": "array", "items": {"type": "string"}},
        "mandatory_local_partner": {"type": ["string", "null"]},
        "win_conditions": {"type": "string"},
        "pilot_scope": {"type": "string"},
        "pilot_duration_months": {"type": "integer"},
        "pilot_success_metrics": {"type": "array", "items": {"type": "string"}},
        "scale_up_path": {"type": "string"},
        "pitch_hook": {"type": "string", "maxLength": 400},
        "risk_register": {"type": "array", "items": {"type": "object", "properties": {"risk_type": {"type": "string"}, "description": {"type": "string"}, "mitigation": {"type": "string"}}}},
        "next_30_day_actions": {"type": "array", "items": {"type": "string"}},
        "scoring": {
          "type": "object",
          "required": ["speed_to_contract", "strategic_moat", "defensibility", "capital_access", "russian_cis_fit", "weighted_total"],
          "properties": {
            "speed_to_contract": {"type": "integer", "minimum": 1, "maximum": 10},
            "strategic_moat": {"type": "integer", "minimum": 1, "maximum": 10},
            "defensibility": {"type": "integer", "minimum": 1, "maximum": 10},
            "capital_access": {"type": "integer", "minimum": 1, "maximum": 10},
            "russian_cis_fit": {"type": "integer", "minimum": 1, "maximum": 10},
            "weighted_total": {"type": "number"},
            "scoring_rationale": {"type": "string"}
          }
        },
        "confidence_tier": {"type": "string", "enum": ["A", "B", "C", "D"]},
        "verification": {"$ref": "#/definitions/VerificationTag"}
      }
    }
  },
  "properties": {
    "metadata": {
      "type": "object",
      "properties": {
        "schema_version": {"type": "string"},
        "generated_at": {"type": "string", "format": "date-time"},
        "weights": {"type": "object"}
      }
    },
    "decrees": {"type": "array", "items": {"$ref": "#/definitions/Decree"}},
    "institutions": {"type": "array", "items": {"$ref": "#/definitions/Institution"}},
    "people": {"type": "array", "items": {"$ref": "#/definitions/Person"}},
    "donor_programs": {"type": "array", "items": {"$ref": "#/definitions/DonorProgram"}},
    "tenders": {"type": "array", "items": {"$ref": "#/definitions/Tender"}},
    "trends": {"type": "array", "items": {"$ref": "#/definitions/Trend"}},
    "global_cases": {"type": "array", "items": {"$ref": "#/definitions/GlobalCase"}},
    "initiatives": {"type": "array", "items": {"$ref": "#/definitions/Initiative"}},
    "solopreneur_mvps": {"type": "array", "items": {"$ref": "#/definitions/SolopreneurMVP"}}
  }
}
