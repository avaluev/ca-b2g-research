# Central Asia B2G Research — Environment Configuration
# Copy to .env (gitignored) and fill in real values.
# NEVER commit .env to a public repo.

# OpenRouter API keys
# - PAID key bills your OpenRouter account; reserved for high-stakes verification (Wave 3 + Wave 5)
# - FREE_1, FREE_2 are free-tier keys (50 calls/day each on free models)
OPENROUTER_KEY_PAID=sk-or-v1-replace-me
OPENROUTER_KEY_FREE_1=sk-or-v1-replace-me
OPENROUTER_KEY_FREE_2=sk-or-v1-replace-me

# Hard cap on total OpenRouter spend per run (USD)
OPENROUTER_BUDGET_USD=20

# Site root for canonical URLs and JSON-LD
SITE_BASE_URL=https://avaluev.github.io/ca-b2g-research

# Operator metadata (used in JSON-LD Person/Organization)
OPERATOR_NAME=Alexandr Valuev
OPERATOR_EMAIL=valuev.alexandr@gmail.com
OPERATOR_GITHUB=https://github.com/avaluev
OPERATOR_LINKEDIN=https://www.linkedin.com/in/avaluev/

# Optional: Anthropic API key for direct API calls (not needed if using Claude Code subscription)
# ANTHROPIC_API_KEY=sk-ant-...
